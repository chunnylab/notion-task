# Notion API Configuration
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_your_notion_api_token_here

# Notion Dashboard Page ID (Optional, for appending plain blocks)
NOTION_DAILY_TASK_PAGE_ID=your_daily_task_page_id_here

# Notion Databases (Recommended for full 2-database PEW system)
NOTION_LOGS_DB_ID=your_daily_logs_database_id_here
NOTION_TASKS_DB_ID=your_daily_tasks_database_id_here
